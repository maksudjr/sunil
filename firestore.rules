rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: queue
    // Document ID: customerId
    // Fields:
    //   - id: string (required)
    //   - name: string (required, size < 100)
    //   - mobile: string (required, size < 20)
    //   - serviceId: string (required)
    //   - serviceName: string (required)
    //   - amount: number (required, > 0)
    //   - transactionId: string (required, size < 50)
    //   - status: string (required, enum: ['অপেক্ষায়', 'অনুমোদিত', 'সম্পন্ন'])
    //   - timestamp: number (required)
    //   - approvedAt: number (optional)
    //   - rating: number (optional, 1-5)
    //
    // Collection: services
    // Document ID: serviceId
    // Fields:
    //   - id: string (required)
    //   - name: string (required)
    //   - price: number (required, > 0)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.email == "maksudjr2020@gmail.com" && request.auth.token.email_verified == true);
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['id', 'name', 'mobile', 'serviceId', 'serviceName', 'amount', 'transactionId', 'status', 'timestamp']) &&
             data.name is string && data.name.size() < 100 &&
             data.mobile is string && data.mobile.size() < 20 &&
             data.amount is number && data.amount > 0 &&
             data.transactionId is string && data.transactionId.size() < 50 &&
             data.status in ['অপেক্ষায়', 'অনুমোদিত', 'সম্পন্ন'] &&
             data.timestamp is number;
    }

    function isValidService(data) {
      return data.keys().hasAll(['id', 'name', 'price']) &&
             data.name is string && data.name.size() < 100 &&
             data.price is number && data.price >= 0;
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /queue/{customerId} {
      allow read: if true; // Publicly readable so users can see their position
      allow create: if isValidCustomer(request.resource.data);
      allow update: if (isAdmin() && isValidCustomer(request.resource.data)) || 
                      (isValidCustomer(request.resource.data) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating']));
      allow delete: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin() && isValidService(request.resource.data);
    }
  }
}
