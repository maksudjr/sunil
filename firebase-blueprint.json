{
  "entities": {
    "Customer": {
      "title": "Customer",
      "description": "A customer in the salon queue",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "mobile": { "type": "string" },
        "serviceId": { "type": "string" },
        "serviceName": { "type": "string" },
        "amount": { "type": "number" },
        "transactionId": { "type": "string" },
        "status": { "type": "string", "enum": ["অপেক্ষায়", "অনুমোদিত", "সম্পন্ন"] },
        "timestamp": { "type": "number" },
        "approvedAt": { "type": "number" },
        "rating": { "type": "number" }
      },
      "required": ["id", "name", "mobile", "serviceId", "serviceName", "amount", "transactionId", "status", "timestamp"]
    },
    "Service": {
      "title": "Service",
      "description": "A salon service",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["id", "name", "price"]
    }
  },
  "firestore": {
    "/queue/{customerId}": {
      "schema": "Customer",
      "description": "The salon queue"
    },
    "/services/{serviceId}": {
      "schema": "Service",
      "description": "The salon services"
    }
  }
}
